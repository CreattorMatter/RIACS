root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.cs]
indent_size = 4
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_between_query_expression_clauses = true
csharp_preferred_var_for_built_in_types = true:suggestion
csharp_preferred_var_when_type_is_apparent = true:suggestion
csharp_preferred_var_elsewhere = true:suggestion
